# Copy to .env. For local development these come from `npx supabase start`
# (run at the repo root). For production use your cloud project values.
#
# Android emulator: the app rewrites 127.0.0.1 -> 10.0.2.2 automatically.
# The anon key is safe to ship: every table is protected by RLS, and the
# LLM key lives ONLY in Edge Function secrets — never in this file.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
