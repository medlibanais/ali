  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.15",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "^18.2.0",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "send": "0.19.2",
    "decode-uri-component": "0.5.0",
    "tar": "^6.2.1",
    "@xmldom/xmldom": "^0.8.15",
    "brace-expansion": "^2.0.7",
    "image-size": "^1.2.1"
