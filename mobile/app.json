{
  "expo": {
    "name": "GROW",
    "slug": "prayerlock",
    "owner": "medlibanaiss-team",
    "extra": {
      "eas": {
        "projectId": "80615719-47d8-4f20-92e3-6f38eebd0306"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "prayerlock",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4ED",
    "splash": {
      "backgroundColor": "#F7F4ED",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.prayerlock.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.prayerlock.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow GROW to access your microphone so you can speak to your Future Self.",
          "speechRecognitionPermission": "Allow GROW to use speech recognition."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow GROW to use Face ID to unlock the app."
        }
      ],
      "expo-asset"
    ]
  }
}
