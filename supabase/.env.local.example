# Copy to supabase/.env.local (never commit the real file).
# Local Edge Function secrets. Production: `supabase secrets set ...`

GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
CRON_SECRET=prayerlock-dev-cron-secret

# AI avatar (generate-avatar function). fal.ai key: https://fal.ai/dashboard/keys
FAL_KEY=your-fal-key-here
# Optional: any fal image-edit model that takes { prompt, image_url }.
AVATAR_MODEL=fal-ai/flux-pro/kontext
